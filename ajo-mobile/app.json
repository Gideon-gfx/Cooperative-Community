{
  "expo": {
    "name": "CC-ÀJỌ",
    "slug": "ajo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cooperativecommunity.ajo",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cooperativecommunity.ajo",
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E6",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "ÀJỌ needs your photos to upload proof of payment."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.jpg",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFF4E6"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "ajo",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94df5968-600c-4129-b5b4-2c3e222e4903"
      },
      "apiUrl": "https://theccajo.com/api"
    },
    "owner": "gideon-gfx"
  }
}
