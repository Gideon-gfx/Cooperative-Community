DATABASE_URL=mongodb://localhost:27017/ajo?replicaSet=rs0
JWT_SECRET=change-me
MONNIFY_API_KEY=
MONNIFY_CLIENT_SECRET=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_CONTRACT_CODE=
MONNIFY_SOURCE_ACCOUNT=
TERMII_API_KEY=
PORT=4000
AJO_PLATFORM_FEE_RATE=0
CCGB_PLATFORM_FEE_RATE=0
TRANSPORT_BASE_FEE_NGN=5000
TRANSPORT_RATE_PER_KM=250
# Where uploads/receipts are stored (served at /files). PUBLIC_BASE_URL defaults to this machine's LAN IP.
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=
# Shared secret for the USSD / inbound-SMS webhooks (required in production). Provider calls /api/ussd?key=<secret>
WEBHOOK_SECRET=
USSD_SHORT_CODE=*384*00#

# Email for password-reset codes. Gmail works: turn on 2-step verification, make an "App password", and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM="ÀJỌ <youraddress@gmail.com>"
