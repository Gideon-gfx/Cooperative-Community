{
  "name": "ajo-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc && npm --prefix ../ajo-web ci --include=dev && npm --prefix ../ajo-web run build",
    "start": "node dist/server.js",
    "migrate": "prisma db push",
    "test": "jest --testPathIgnorePatterns=\\.int\\.test",
    "test:int": "jest -c jest.int.config.js --runInBand",
    "db": "node scripts/dev-db.js",
    "dev:all": "node scripts/dev-all.js",
    "seed:facilitator": "ts-node --transpile-only scripts/seed-facilitator.ts",
    "backfill:funds-mode": "ts-node --transpile-only scripts/backfill-funds-mode.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^6.19.3",
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "handlebars": "^4.7.10",
    "uuid": "^11.1.1"
  }
}
